# ── Google Sheet CMS ────────────────────────────────────────────────
# The spreadsheet that holds the "Products" and "Enquiries" tabs.
GOOGLE_SHEET_ID=your_sheet_id_here

# Service account that can read/write that sheet.
# Share the sheet with GOOGLE_CLIENT_EMAIL as an Editor.
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the whole private key. Keep the \n escapes on one line, OR paste the real
# multi-line key wrapped in double quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Public site URL (used for canonical links, sitemap, Open Graph) ──
NEXT_PUBLIC_SITE_URL=https://shubhamtradingco.in

# ── Enquiry email relay (optional) — keeps the email copy working ───
# Free key from https://web3forms.com — leave blank to disable the email copy.
WEB3FORMS_KEY=
